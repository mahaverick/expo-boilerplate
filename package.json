{
  "name": "expo-boilerplate",
  "private": true,
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "description": "Expo boilerplate for Mahaverick Labs projects",
  "author": {
    "name": "Mahaverick Labs",
    "email": "support@mahaverick.com"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "check": "pnpm typegen && vp check && eslint . --max-warnings 0",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typegen": "expo customize tsconfig.json && test -f .expo/types/router.d.ts",
    "test": "jest --testNamePattern=\"^(?!user-facing copy finds the copy it guards$)\"",
    "test:coverage": "jest --coverage --testNamePattern=\"^(?!user-facing copy finds the copy it guards$)\"",
    "lint:docs": "node scripts/lint-docs.mjs",
    "sync:check": "node scripts/sync-check.mjs",
    "styleseed": "node scripts/styleseed.mjs",
    "expo:doctor": "expo-doctor",
    "export": "expo export --platform all --output-dir dist",
    "prepare": "vp config --hooks --no-agent",
    "gate": "pnpm check && pnpm typecheck && pnpm lint:docs && pnpm sync:check && pnpm knip && pnpm expo:doctor && pnpm test:coverage && pnpm export",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "@formatjs/intl-getcanonicallocales": "^3.3.0",
    "@formatjs/intl-locale": "^5.4.2",
    "@formatjs/intl-pluralrules": "^7.0.2",
    "@formatjs/intl-relativetimeformat": "^13.0.1",
    "@posthog/core": "1.64.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "nativewind": "4.2.7",
    "posthog-react-native": "4.85.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-get-random-values": "^2.1.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.14.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "^1.21.6",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "knip": "6.39.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-plus": "catalog:"
  }
}
