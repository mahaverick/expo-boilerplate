{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Entries, project files and plugins (expo, eslint, vite) are knip's
  // defaults. Each ignore below says why the finding is not dead code.
  "ignoreDependencies": [
    // The stack's libraries, installed with the toolchain so that expo-doctor
    // and `expo install --check` see them from the start. No file under src/
    // imports them yet; drop each entry once one does.
    "@tanstack/react-form",
    "@tanstack/react-query",
    "axios",
    "expo-secure-store",
    "react-native-mmkv",
    "react-native-nitro-modules",
    "zod",
    "zustand",
    // knip's expo plugin lists expo-updates unless the config sets
    // `updates.enabled: false`. The app does not ship over-the-air updates.
    "expo-updates",
  ],
}
